{
  "name": "@privatus/cloudflare-crawler-log-shipper",
  "version": "1.0.0",
  "private": true,
  "description": "Ship AI/search crawler request logs (no IPs) from Cloudflare to Privatus Analytics",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "deploy": "wrangler deploy",
    "deploy:logpush": "wrangler deploy -c wrangler.logpush.toml"
  },
  "devDependencies": {
    "vitest": "^4.1.11",
    "wrangler": "4.143.0"
  },
  "overrides": {
    "undici": "^7.30.0"
  }
}
